GEMINI_API_KEY=your_gemini_api_key_here

# LangSmith tracing for the LangGraph orchestrator (optional). Set
# TRACING=true only once a real key from smith.langchain.com ->
# Settings -> API Keys is in place; false runs the graph untraced.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_your_key_here

# Instagram publishing + insights (src/instagram.py). Both are needed
# for the live publish path and metric refresh; without them manual
# entry still works and dry runs still preview. The token comes from a
# Meta app (ZeroPageFilms, Instagram Login) with instagram_business_basic +
# instagram_business_content_publish + instagram_business_manage_insights.
# Tokens last 60 days: the nightly sweep refreshes it (src/refresh_metrics.py),
# the nightly preflight says loudly when it is dead or under 14 days, and
# `python -m ops.ig_tokens check|refresh|publish` is the by-hand door.
# IG_USER_ID=your_ig_professional_account_id
# IG_ACCESS_TOKEN=your_long_lived_token
# The nightly sweep (src.refresh_metrics) refreshes the long-lived token's
# 60-day clock; a NEW token Meta issues is kept in data/ig_token.json
# (IG_TOKEN_STORE overrides) and read from there until this line changes.

# TikTok publishing + metrics (src/tiktok.py, 2026-09-07). One token
# does both halves: Direct Post (video.publish) hands TikTok a PUBLIC
# URL to pull the file from, and the Display API (video.list) reads the
# counts back. Unset, the module reports "TIKTOK_ACCESS_TOKEN not set"
# and the metrics sweep records that as a per-video failure -- nothing
# breaks, the lane is just dark.
# WHAT THE CREDENTIAL DOES NOT BUY: TikTok gates the Direct Post scope
# behind its own app review, and an UNREVIEWED app can only drop a video
# into the creator's inbox as a draft. The module is done; the approval
# is a filing, not a build.
# The URL's domain must also be verified on the developer app, or init
# fails with url_ownership_unverified -- that is the R2 domain here.
# TIKTOK_ACCESS_TOKEN=your_tiktok_user_access_token
# Only needed by TikTok's user-scoped reads; the endpoints this module
# calls identify the creator from the token itself.
# TIKTOK_OPEN_ID=your_tiktok_open_id

# The standing L4 enable (src/autopilot.py). Even set, nothing runs
# without a per-run --approve AND --live AND no data/autopilot.off kill
# switch -- three independent conditions, dry-run otherwise. All three
# are facts about the installation; the per-RUN approval to publish is
# ZEROPAGE_POST_OK=1, set on the command (the serve line, the cron line,
# the autopilot CLI) and deliberately never listed here -- the posting
# equivalent of FAL_SPEND_OK. Without it every post action reports
# "post-unapproved" and publishes nothing.
# ZEROPAGE_AUTOPILOT=1

# Cloudflare R2 (src/storage.py). Uploads a rendered clip and writes its
# public URL onto the shot autopilot.build_plan() checks before it will
# emit a post action -- unset, publish_shot_media() fails cleanly with a
# result dict naming which of these is missing, rather than posting
# nowhere silently. R2_PUBLIC_BASE_URL is the bucket's public domain
# (either R2's own pub-<hash>.r2.dev dev domain, or a custom domain
# attached to the bucket in the dashboard), no trailing slash.
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET=your_bucket_name
# R2_PUBLIC_BASE_URL=https://pub-yourhash.r2.dev

# Higgsfield Cloud API (src/higgsfield.py) -- Soul STILLS only since
# 2026-09-26 (fal is the only video renderer). The API bills Higgsfield API
# credits, a separate balance from the app subscription. HIGGSFIELD_SPEND_OK=1
# is for unattended runs only, and HIGGSFIELD_DAILY_CAP (default 6) is the
# standing wall. Keys are created in Higgsfield Cloud; the docs call them
# HF_API_KEY_ID / HF_API_KEY_SECRET, which this reads as a fallback.
# HIGGSFIELD_API_KEY_ID=your_higgsfield_key_id
# HIGGSFIELD_API_KEY_SECRET=your_higgsfield_key_secret
# HIGGSFIELD_DAILY_CAP=6
# HIGGSFIELD_IMAGE_COST_USD=0.05  # an estimate -- no published API price

# fal.ai (src/fal.py) -- THE video renderer, the only one since 2026-09-26
# (docs/tasks/task-fal-only.md): ONE operator key over ONE queue API for
# kling, ltx, wan, seedance and veo. Every render holds credits. The key is
# the whole setup for a person (the click is the approval), and
# FAL_SPEND_OK=1 is for unattended runs only. There is no free app to fall
# back to -- fal is an API company, so the refusal names the estimate.
# FAL_KEY=your_fal_key
# FAL_MODEL=ltx2.3                # the DEFAULT: $0.06/s at 1080p, 6s
#                                 # minimum -- the cheapest clip there is.
#                                 # Others: wan3, kling3-turbo-pro,
#                                 # seedance2-fast, seedance2, veo3.1 (ids +
#                                 # prices dated 2026-09-26 in
#                                 # fal.VIDEO_MODELS).
# FAL_DAILY_CAP=6
# FAL_TIMEOUT_S=900
# Real per-second rate cards, not estimates -- override only when fal
# reprices a model (applies to every resolution of that one).
# FAL_PRICE_LTX2_3=0.06
# FAL_IMAGE_COST_USD=0.04         # FLUX, per megapixel

# Nano Banana (src/nano_banana.py) -- Gemini image generation on the
# same GEMINI_API_KEY as everything else, so there's no separate key or
# spend gate; the wall is the daily cap. Default model is
# gemini-2.5-flash-image (Nano Banana); set the Pro preview for better
# text/layout at several times the per-image price.
# THE KEYFRAME MODEL. gemini-2.5-flash-image (the default) is Nano Banana at
# $0.039 an image; gemini-3-pro-image is Nano Banana Pro, GA as of 2026-09-12,
# at $0.134 -- 3.4x. Worth it because the keyframe is the only channel a
# reference photo has into a gen4 render, and stays the only one for timeline
# part 2 onward, which keep the keyframe by design. Pair it with
# NANO_IMAGE_SIZE=2K: on Pro, 2K and 1K are one price tier, and the default
# is 1K, so the extra pixels on a face are free.
# NANO_BANANA_MODEL=gemini-3-pro-image
# NANO_IMAGE_SIZE=2K
# NANO_DAILY_CAP=20

# --- The two walls on every render tool (src/generative.py cap_error) ---
# Per-account caps (FAL_DAILY_CAP, HIGGSFIELD_DAILY_CAP,
# MIDJOURNEY_DAILY_CAP, NANO_DAILY_CAP) are fairness: what one person may
# spend in a day. The GLOBAL caps are the credit card: a ceiling on the
# whole installation, from when every render billed the operator's keys.
#
# THEY ARE OFF BY DEFAULT since 2026-09-14 (each defaults to 0 = no
# ceiling). Since 2026-09-26 every render is on the operator's key AND
# holds the account's credits, so an account with no credit cannot spend,
# and the worst case is (per-account cap x funded accounts). Set any of these to a positive number to put the wall back -- the
# arithmetic is roughly (per-account cap x people), and the values below
# are what THREE people looked like (the operator plus two pilot users).
# FAL_GLOBAL_DAILY_CAP=18           # 6 x 3  -- counted across kling/ltx/wan/seedance/veo rows
# HIGGSFIELD_GLOBAL_DAILY_CAP=18    # 6 x 3
# MIDJOURNEY_GLOBAL_DAILY_CAP=30    # 10 x 3
# NANO_GLOBAL_DAILY_CAP=60          # 20 x 3

# --- Production data -------------------------------------------------
# The pipeline and RAG library now live in Supabase Postgres. Use the
# Supabase SESSION pooler connection string for cloud deployments; the
# password must be URL-encoded when it contains reserved URL characters.
# RAG_DATABASE_URL may be the same value as DATABASE_URL. Keeping both
# explicit in production makes an accidental fallback visible.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
# RAG_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# Signs the render quotes the Queue shows, so the price a person approved
# is provably the price rendered (src/pricing.py). ITS OWN SECRET, never
# SESSION_SECRET: rotating this one invalidates at most an hour of
# outstanding quotes. Different per environment -- a dev quote must not verify
# in production. Unset, prices still show and approving still works, but
# no token rides with them and a client that sends one is answered 503.
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# QUOTE_SIGNING_SECRET=

# --- Stripe (app/billing.py + src/billing.py, 2026-09-18) --------------------
# Checkout, the Customer Portal and the webhook that grants credit into the
# ledger. Test-mode keys until the whole flow has passed end to end. One
# Price per plan and pack (src/pricing.PLANS / TOPUP name them); the dollar
# amounts on the site are pricing.py's, the Price is what is charged, and a
# person keeps the two equal. Unset = the plan buttons say "checkout not
# configured" and /billing/webhook answers 503.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...          # from `stripe listen` locally, the dashboard on Fly
# STRIPE_PRICE_STARTER=price_...          # Starter  $15/mo  1,500 credits
# STRIPE_PRICE_CREATOR=price_...          # Creator  $35/mo  3,500 credits
# STRIPE_PRICE_STUDIO=price_...           # Studio   $95/mo  9,500 credits
# STRIPE_PRICE_STARTER_YEAR=price_...     # the yearly twins: $144 / $336 / $912 a year,
# STRIPE_PRICE_CREATOR_YEAR=price_...     #   released month by month (src/billing.release_due;
# STRIPE_PRICE_STUDIO_YEAR=price_...      #   `python -m src.billing release` daily)
# STRIPE_PRICE_TOPUP=price_...            # 1,000 credits, $10, one-time
# BILLING_RETURN_URL=https://zpf-web.vercel.app   # where Checkout sends people back (default: STUDIO_URL, then SITE_URL)

# Deployment posture (app/main.py). 1 = the dev machine: /studio and
# every legacy per-stage screen register alongside /ui. Unset or 0 = a
# public deployment: only /, /signin, /ui and /api exist -- the dev
# console isn't hidden, it's never registered, so /studio 404s like any
# undefined route. Set it locally; leave it out of any public deploy.
DEV_TOOLS=1

# The public origin, no trailing slash. Every canonical tag, schema @id,
# sitemap <loc> and llms.txt link is built from this. Unset, it falls
# back to http://127.0.0.1:8000 -- fine locally, wrong the moment the
# site is public, so set it before deploying.
# SITE_URL=https://your-domain.com

# The React studio's public origin (web/, its own deployment), when there
# is one. Set, it is THE studio: /ui, the landing page's door and a
# sign-in with no return address all hand the session to it through
# /auth/handoff, and the Jinja shell stays reachable only as /ui?legacy=1.
# Its origin is trusted like a FRONTEND_ORIGINS entry. Unset, /ui is the
# studio, as on a dev machine.
# STUDIO_URL=https://zeropage-web.fly.dev

# --- Sign-in (app/auth.py) -------------------------------------------
# Session-signing key for the zp_session cookie. Generate once:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset = an ephemeral key per process (dev only; sessions die on restart).
# SESSION_SECRET=generate_me

# Supabase Auth (2026-09-03): identity -- Google, Discord, email+password,
# the passwords, the verified-email rule -- is the Supabase project's.
# Dashboard -> Project Settings -> API: the project URL and the anon key.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# Dashboard -> Project Settings -> API -> JWT Settings: the JWT secret,
# used to verify the access token at sign-in. Leave unset on a project
# that signs with asymmetric keys; the app then verifies against
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json instead.
# SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters
# Which OAuth buttons the sign-in page offers -- must match what is
# enabled under Authentication -> Providers in the dashboard (the Google /
# Discord client ids and secrets are entered THERE now, and each provider's
# console gets Supabase's callback: https://<project-ref>.supabase.co/auth/v1/callback).
# Authentication -> URL Configuration needs the app's callback in the
# redirect allow-list: <SITE_URL>/auth/callback (and http://localhost:8000/auth/callback).
# SUPABASE_PROVIDERS=google,discord

# ── Instagram RESEARCH (src/scout.py's instagram lane) ────────────────────
# SEPARATE CREDENTIAL from IG_ACCESS_TOKEN, and not optional-by-accident.
# IG_ACCESS_TOKEN is an Instagram-Login token on graph.instagram.com and
# publishes; it CANNOT read other accounts, and graph.facebook.com cannot
# even parse it. Business Discovery and hashtag search are Facebook-Login
# only, so they need their own token here. Without it the lane reports
# "IG_GRAPH_TOKEN not set" once per pass and the other four lanes run on.
#
# There is NO For You / Explore endpoint on any Instagram API — probed
# against a live token 2026-08-31: explore, reels, trending,
# recommended_media and discover all answer "nonexisting field". This
# lane reads what is PERFORMING instead (posts + like/comment counts from
# handles on file, and Meta's own top ranking for a hashtag).
#
# To get one: a SECOND Meta app (Instagram API with Facebook login -- not
# ZeroPageFilms), the IG account Professional and linked to the Page, then a
# User token from Graph API Explorer with instagram_basic + pages_show_list +
# pages_read_engagement + business_management, and
#   python -m ops.ig_tokens research --app-id <that app's id>
# which exchanges it for the 60-day token (fb_exchange_token), finds the
# Page's instagram_business_account and writes IG_GRAPH_TOKEN + IG_BUSINESS_ID.
# A short-lived token pasted straight in here dies within the hour -- which
# is what happened on 2026-09-01.
# Meta caps hashtag ID lookups at 30 unique tags per rolling 7 days;
# src/instagram.py caches ids forever so only genuinely new tags cost.
IG_GRAPH_TOKEN=
# Usually the same number as IG_USER_ID. Set only if the Business account
# id as graph.facebook.com sees it differs.
IG_BUSINESS_ID=
# The research app's id, so `ops.ig_tokens research` needs no --app-id.
IG_RESEARCH_APP_ID=

# --- The research node (src/research_agent.py) -------------------------------
# An agent node fills the scout's bank before the 6am runs read it. With no
# key it reports that and the night falls through to the crawl and then to
# prompts/sparks.txt, exactly as it did before the node existed.
#
# Web signals come from scout.gather_web (grounded Gemini search, already
# used by the crawl), not from a model-side search tool -- Gemini only
# permits google_search alongside custom function declarations on the
# Gemini 3 family, and a design needing that permission breaks on a swap.
#
# It reaches the board through THIS repo's own MCP server over stdio, launched
# without --engine so the agent gets the twelve free tools and never
# `run_graph` -- the tool that would let it fire a nightly run from inside one.
#
# Do NOT `pip install langchain-mcp-adapters`. It requires mcp<2 and this repo
# requires mcp>=2; installing it downgrades the SDK and src/mcp_server.py stops
# importing altogether.
# It runs on GEMINI_API_KEY above by default -- nothing new to buy. Set
# RESEARCH_PROVIDER=anthropic (and its key) only to switch it.
# RESEARCH_PROVIDER=gemini             # default; the other value is 'anthropic'
# ANTHROPIC_API_KEY=sk-ant-...         # only for RESEARCH_PROVIDER=anthropic
# RESEARCH_MODEL=gemini-3-flash-preview  # default follows the provider
# RESEARCH_BANK_TARGET=8                # stop researching once the bank holds this many unused sparks
# RESEARCH_MAX_STEPS=40                 # the react loop's wall

# --- MCP: the idea board, reachable from Claude ------------------------------
# src/mcp_server.py exposes the pre-production board as an MCP server.
# Claude Desktop launches it over stdio (ops/connect-claude.md) -- that
# path needs NOTHING here except the engine flag below.
#
# The two tools that spend model credit: `research` (a scout crawl plus
# digest) and `generate` (one LangGraph pass, ending PARKED in the
# Queue). Cents, not render dollars -- a clip still only renders on Queue
# approval, and `generate` refuses outright while ZEROPAGE_RENDER=1.
ZEROPAGE_MCP_ENGINE=1

# The HTTP mount on the web app (app/mcp_mount.py), for a caller that is
# NOT Claude Desktop -- the studio app's own agent over a network.
# ZEROPAGE_MCP=1 with no token is REFUSED, never served open.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ZEROPAGE_MCP=1
# ZEROPAGE_MCP_TOKEN=
# Hosts the endpoint answers to. `*` disables the SDK's DNS-rebinding
# check -- needed behind a quick tunnel whose hostname changes on every
# restart, and safe only because the bearer token is checked first.
# ZEROPAGE_MCP_HOSTS=*

# --- reference image lanes (2026-09-05): images off the internet per spark ---
# Openverse is keyless and on by default; set OPENVERSE_LANE=0 to turn it off.
# Google image search: a Programmable Search Engine (cse.google.com) set to
# "search the entire web" with Image search ON -> its cx here; key is an API
# key with "Custom Search JSON API" enabled (falls back to GEMINI_API_KEY).
GOOGLE_CSE_ID=
GOOGLE_CSE_KEY=
# Reddit: a "script" app at reddit.com/prefs/apps -> id + secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- generated references (2026-09-06): a still per spark, in the look ---
# Midjourney first (needs ACEDATA_API_KEY + MIDJOURNEY_SPEND_OK=1 on the run),
# then Gemini's image model (GEMINI_API_KEY), then Higgsfield Soul -- except
# a still of Michael, which goes to Gemini FIRST with his photos attached.
REFGEN_LANE=1
REFGEN_DAILY_CAP=8
# REFGEN_PROVIDERS=midjourney,nano,higgsfield
ACEDATA_API_KEY=

# --- Pinterest boards lane: pins YOU saved, matched to the spark ---
# A Pinterest developer app token with boards:read + pins:read, and the
# board name (or id) per brand.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ANTIHERO=antihero refs
PINTEREST_BOARD_ZEROPAGE=zeropage refs


# A trained Higgsfield Soul, if you have one. NOT how Michael's face is
# rendered (2026-09-06: his Soul produced a different actor) -- a still of
# him goes to Nano Banana Pro with the real photos in characters/michael
# attached (refgen.LIKENESS_PHOTOS, NANO_LIKENESS_MODEL below). Leave unset.
HIGGSFIELD_SOUL_ID=
HIGGSFIELD_SOUL_STRENGTH=1.0
# NANO_LIKENESS_MODEL=gemini-3-pro-image-preview
# LIKENESS_PHOTOS=IMG_0586.JPG,IMG_0593.JPG,IMG_0599.JPG

# --- what the learning loop is allowed to learn from (2026-09-07) ---
# The ten videos on the live database are hand-made YouTube uploads that
# predate the pipeline -- short films, cocktail recipes, a haircut, a
# motovlog -- and they were feeding promote_winners, post_seo signals and
# the taste judge as if the pipeline had made them. They are marked
# `videos.legacy` now: still shown everywhere (Analytics, the library,
# metric refresh), skipped by every reader that TEACHES. Set this to put
# them back -- for a before/after measurement, or for an installation
# whose back catalogue really is the model to imitate.
# ZEROPAGE_LEARN_FROM_LEGACY=1

# --- which gates route, and which only record (2026-09-07) ---
# Over the graded holds the prompt gate agreed with Mike's own would-post
# verdict ~38% of the time -- near chance -- and no dimension of its
# rubric separated what he would post from what he would not. So the
# graph stopped predicting the clip from the PROMPT: the LLM judges still
# score and still store (critique, prompt_scores, the hold payload, the
# parked reason on the card), and they no longer route to `hold`. A
# failing prompt still gets its bounded rework, then reaches the keyframe
# carrying its verdict -- "advisory: prompt gate 4/10 — ..." -- so the
# morning review decides in front of the still instead of in front of a
# guess about it. Selection moved after the render (orchestrator.
# select_clip, and the JUDGE hook where a video-level judge will land).
#
# Everything CODE enforces is untouched in both modes: validate_concept's
# warnings, the prompt gate's own deterministic layer 1 (empty, too thin,
# a leftover {token} -- that renders garbage whatever a judge thinks of
# the writing, so it still holds after its rework pass), clip QC,
# _post_gate, the likeness rule, the kill switch, and every credit gate
# below. Only the rubric -- the taste judge -- goes advisory. A
# camera-only concept still holds too: there is nothing to render.
#
# `hard` is the way back: the pre-2026-09-07 hold-on-judge behaviour,
# exactly. Anything that is not literally `hard` reads as advisory, so a
# typo cannot silently re-arm the gate.
# ZEROPAGE_GATES=hard

# --- which model writes a scene (src/gemini_utils.py BRAINS, 2026-09-09) ---
# Two tiers, one table, resolved in one place so the composer's picker and
# the nightly walk cannot disagree about what a tier means:
#
#   fast       gemini-3-flash-preview. The default everywhere.
#   reasoning  gemini-3.1-pro-preview at thinking level HIGH. Roughly 4x
#              the per-token price ($2/$12 per 1M vs $0.50/$3), plus
#              thinking tokens billed at the output rate -- /costs prices
#              both, and `stage=concepts` is where it shows up.
#
# The reasoning tier takes NO FALLBACK on purpose. The default chain's
# first substitute is gemini-3.1-flash-lite, the least capable model here,
# and a scene asked for on the reasoning tier and quietly answered by it
# saves, lands on the board, and reads identically to one that was not --
# so it raises SubstitutionRefused instead. On the composer that is a
# person seeing an error and pressing Create again.
#
# ZEROPAGE_BRAIN is the NIGHT's tier only; the composer sends its own per
# run. Unset means fast, and that is the load-bearing default: a walk is
# NIGHTLY_SPARKS x 2 brands, so putting the night on the expensive tier is
# a bill somebody chooses. An unknown value reads as fast rather than
# raising -- nobody is watching at 3:30am.
# ZEROPAGE_BRAIN=reasoning
#
# Override the reasoning tier's model without a code change. Verify a new
# id against models.list before trusting it (the fal/veo lesson: a model
# name in a doc is not a model name in the API).
# ZEROPAGE_REASONING_MODEL=gemini-3.1-pro-preview

# --- the nightly walk's budget and volume (src/nightly.py, 2026-09-07) ---
# The walk is 8 sparks x 2 brands = 16 graph runs, and until now it had no
# ceiling except the daily image cap. One night with a depleted Gemini card
# retried every call six times; one DNS miss to the pooler ran fifteen more
# runs into the same dead socket. NIGHTLY_BUDGET_USD is the dollar wall:
# checked against costs.spent_since(the walk's own start) before each run,
# and the walk stops -- with the reason on a nightly_runs row and a hold row
# -- when it is reached. A TIMESTAMP, not "today", because a 22:00 walk and
# a 03:30 walk are not the same calendar day.
# NIGHTLY_BUDGET_USD=5.00
# LangSmith's client retries a failed export and prints a traceback per
# call, which on a night with no route to it is thousands of lines around
# the sixteen anyone wants. The runner forces tracing off for the walk;
# set this to keep it on.
# NIGHTLY_TRACING=1

# --- who may spend the operator's subscriptions (src/manual_lane.py) ---
# NOTHING TO SET HERE, AND THAT IS THE POINT (2026-09-08). The two MANUAL
# render lanes -- `ops/render_queue.py --provider higgsfield|manual` --
# do not spend API credits. The Higgsfield lane spends the OPERATOR'S
# personal app subscription behind the MCP; rendering a paying tenant's
# shot on it is reselling a consumer subscription -- an account-termination
# risk that takes every tenant's renders down at once. The manual lane
# files a clip rendered anywhere, free, with no hold. (It was the Runway
# Unlimited lane until 2026-09-26.)
#
# So the gate is a COLUMN, `accounts.manual_lane_operator`, and it used
# to be the two env vars ZEROPAGE_OPERATOR_ACCOUNTS / _EMAILS. They are
# gone, not deprecated: anyone who can set a variable on this process --
# a deploy config, this file on a shared box, a wrapper script -- could
# name themselves operator, and a gate with two doors is one door. Turn
# it on once, from a shell that can reach the database:
#
#     python -m src.accounts operator zeropage --on      # --off to revoke
#
# It still FAILS CLOSED: on a database where nobody has run that, NOBODY
# may use the lanes -- not the bootstrap account, not the unowned pool a
# fresh database hands a CLI.
#
# This gates the MANUAL LANES ONLY. The API-billed renderer (src/fal.py)
# is untouched by it -- it spends the operator's key, metered per call,
# under its own FAL_SPEND_OK gate, daily cap and credit hold.

# --- the graph's two input-side nodes ---------------------------------
# `research` (a Claude agent) fills the spark bank; `scout` drains it and
# hands the run a researched direction plus the images behind it. Set to
# 1 to make them the default for any caller that names no direction --
# the 6am job, `python -m src.trigger` with no flags. A caller that
# passes an explicit spark or scout_finding_id (Studio Create, Director,
# the MCP `generate` tool) keeps its own direction whatever these say,
# because the scout node REPLACES the direction and the research node
# spends Anthropic credit. `--no-scout` / `--no-research` force them off
# for one run. See orchestrator.resolve_nodes.
ZEROPAGE_GRAPH_SCOUT=1
ZEROPAGE_GRAPH_RESEARCH=1


# React Director UI. Local /ui uses localhost:3000 automatically.
# Set to the deployed React frontend's full canvas URL to enable outside local dev.
# DIRECTOR_FRONTEND_URL=https://your-frontend.example/studio/flows
