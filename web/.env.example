# Same-origin proxy: browser requests stay on the frontend origin; cookies travel
# through Next.js to FastAPI. Set this to the deployed backend for production.
API_UPSTREAM=http://localhost:8000

# Optional direct cross-origin mode. Leave unset for the proxy above.
# If set, the API must allow this frontend origin in FRONTEND_ORIGINS.
# NEXT_PUBLIC_API_URL=https://zeropage-studio.fly.dev
