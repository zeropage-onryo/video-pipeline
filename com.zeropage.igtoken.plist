<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.zeropage.igtoken</string>
  <!-- The ONE scheduled job on this Mac since 2026-09-28, replacing
       com.zeropage.morningprompts (the nightly walk, now unscheduled).
       Daily, but it makes no Meta call until the publishing token's last
       refresh is 30 days old (ops/ig_tokens.py `keep`). launchd runs a
       StartCalendarInterval it slept through once on wake, so a closed
       lid only moves the refresh, never skips the 60-day window. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/iphone/Documents/PRODUCTION PIPLINE .GIT/ops/ig_token.sh</string>
    <string>keep</string>
    <string>--days</string>
    <string>30</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  <!-- launchd opens these itself, before exec: never under ~/Documents -->
  <key>StandardOutPath</key><string>/Users/iphone/Library/Logs/zeropage/ig_token.out</string>
  <key>StandardErrorPath</key><string>/Users/iphone/Library/Logs/zeropage/ig_token.err</string>
</dict>
</plist>
