# Video files
*.mp4
*.mov
*.braw

# Media directories
/footage
/renders
/locations

# Environment variables
.env
# ...and every backup of it. `.env.bak.<timestamp>` files get made by hand
# during token rotation and are NOT covered by ".env" alone -- two of them
# were one `git add -A` away from putting live Gemini, R2, Instagram and
# OAuth credentials into history permanently (2026-09-02).
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
venv/

# macOS
.DS_Store

# Local test data
data/*.db
data/thumbs/

# Generated pipeline artifacts
manifest.json
pitches.json
concepts.json
data/promotion_queue.json
data/autopilot.off
venv-studio/

# Personal reference photos -- not public yet
/characters
/props

# Runtime state the app/scheduler writes
.langgraph_api/
data/morning_prompts.*
data/renders/
data/_scratch_*
data/*.log
data/*.db*

# Reference photos uploaded through the composer and the sheets built
# from them -- user data and generated artifacts, not source (2026-08-29)
data/refs/
data/*.jpg
data/*.tar.gz

# Claude Code's per-machine permission allowlist: local paths, no value
# to anyone else checking this out
.claude/settings.local.json

# Claude's scratch space over the FUSE mount: stale git locks it cannot
# unlink, diagnostic logs, staged tarballs, index backups. The folder name
# says what it is. Ignored because c02fd3a swept 18 of them into history
# before this rule existed.
data/_to_delete/

# Worktree plumbing, never source (2026-09-04): a worktree's data/refs,
# data/renders and data/thumbs are SYMLINKS to the main checkout's, and
# the `venv` shortcut points at the main checkout's interpreter. The
# directory rules above end in "/" and so do not match a symlink, which is
# why these kept showing as untracked. Same for the symlink-backout and
# local-refs scratch folders the 2026-09-03 symlink work left behind.
data/refs
data/renders
data/thumbs
data/refs.local-*
data.symlink-backout-*
venv
